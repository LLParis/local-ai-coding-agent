<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ggen5.coding-intelligence.codex-catalog-maintenance</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/pro/.local/libexec/coding-intelligence/codex-catalog-maintenance.py</string>
        <string>--limit</string>
        <string>25</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CODEX_HOME</key>
        <string>/Users/pro/.codex</string>
        <key>HOME</key>
        <string>/Users/pro</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/Users/pro/.local/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/dev/null</string>
</dict>
</plist>
